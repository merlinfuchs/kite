{
  "id": "ask-ai",
  "version": 2,
  "changelog": [
    {
      "version": 2,
      "notes": "The personality is now a parameter, so you can change it on this page without opening the flows."
    }
  ],
  "name": "Ask AI",
  "description": "Members ask AI questions with /ask or by mentioning the bot.",
  "about": [
    "Members ask the AI a question with /ask, and only they see the answer. They can also mention the bot in a message, and it replies to that message in the channel for everyone to read.",
    "The system prompt setting gives the AI its personality and rules, like the topics it should stick to or the language it should answer in. Leave it empty for a general assistant. Answers use the Fast AI model, and the 10,000 monthly credits of the free plan cover more than 1,400 of them."
  ],
  "faq": [
    {
      "question": "Which AI model does it use?",
      "answer": "The Fast model tier. You can switch the AI block to Balanced or Smartest in the editor, which gives better answers and costs more credits per answer."
    },
    {
      "question": "Does the bot read every message?",
      "answer": "No. The event listener only runs for messages that mention the bot, so other messages are never sent to the AI."
    },
    {
      "question": "Can I keep the AI on topic?",
      "answer": "Yes. Describe in the system prompt what the AI should help with and how it should answer, for example only questions about your game or your server's rules."
    },
    {
      "question": "Do I need the Message Content Intent?",
      "answer": "No. Discord includes the text of messages that mention your bot even when the intent is off."
    }
  ],
  "usage": {
    "unit": "AI answers",
    "unit_one": "answer",
    "per_thousand_members": 150
  },
  "icon": "brain-circuit",
  "category": "ai",
  "parameters": [
    {
      "key": "system_prompt",
      "label": "Personality",
      "description": "Give the AI a personality. Tell it how to respond to questions.",
      "type": "textarea",
      "required": false
    }
  ],
  "commands": [
    {
      "id": "ask",
      "flow_source": {
        "nodes": [
          {
            "id": "command_l72",
            "type": "entry_command",
            "position": {
              "x": 0,
              "y": 210
            },
            "data": {
              "name": "ask",
              "description": "Ask a question to the AI."
            }
          },
          {
            "id": "arg_0l1",
            "type": "option_command_argument",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "name": "question",
              "description": "The question to ask the AI.",
              "command_argument_type": "string",
              "command_argument_required": true
            }
          },
          {
            "id": "ai_ye9",
            "type": "action_ai_chat_completion",
            "position": {
              "x": 0,
              "y": 420
            },
            "data": {
              "ai_chat_completion_data": {
                "system_prompt": "{{params.system_prompt}}",
                "prompt": "{{interaction.command.args.question}}"
              }
            }
          },
          {
            "id": "response_fc2",
            "type": "action_response_create",
            "position": {
              "x": 0,
              "y": 630
            },
            "data": {
              "message_data": {
                "content": "{{nodes.ai_ye9.result}}"
              },
              "message_ephemeral": true
            }
          }
        ],
        "edges": [
          {
            "id": "987121",
            "source": "arg_0l1",
            "target": "command_l72"
          },
          {
            "id": "76141837",
            "source": "command_l72",
            "target": "ai_ye9"
          },
          {
            "id": "287102264",
            "source": "ai_ye9",
            "target": "response_fc2"
          }
        ]
      }
    }
  ],
  "event_listeners": [
    {
      "id": "ask-on-mention",
      "source": "discord",
      "flow_source": {
        "nodes": [
          {
            "id": "event_312",
            "type": "entry_event",
            "position": {
              "x": 0,
              "y": 210
            },
            "data": {
              "event_type": "message_create",
              "description": "Ask a question to the AI by pinging the bot."
            }
          },
          {
            "id": "filter_def",
            "type": "option_event_filter",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "event_filter_target": "message_mentions_bot",
              "event_filter_mode": "equal"
            }
          },
          {
            "id": "ai_20v",
            "type": "action_ai_chat_completion",
            "position": {
              "x": 0,
              "y": 630
            },
            "data": {
              "ai_chat_completion_data": {
                "system_prompt": "{{params.system_prompt}}",
                "prompt": "{{event.message.content}}"
              }
            }
          },
          {
            "id": "typing_0pu",
            "type": "action_typing_trigger",
            "position": {
              "x": 0,
              "y": 420
            },
            "data": {
              "channel_target": "{{event.channel.id}}"
            }
          },
          {
            "id": "message_70u",
            "type": "action_message_create",
            "position": {
              "x": 0,
              "y": 840
            },
            "data": {
              "channel_target": "{{event.channel.id}}",
              "reply_target": "{{event.message.id}}",
              "message_data": {
                "content": "{{nodes.ai_20v.result}}"
              }
            }
          }
        ],
        "edges": [
          {
            "id": "393896966",
            "source": "filter_def",
            "target": "event_312"
          },
          {
            "id": "739147611",
            "source": "event_312",
            "target": "typing_0pu"
          },
          {
            "id": "522228760",
            "source": "typing_0pu",
            "target": "ai_20v"
          },
          {
            "id": "870705592",
            "source": "ai_20v",
            "target": "message_70u"
          }
        ]
      }
    }
  ]
}
