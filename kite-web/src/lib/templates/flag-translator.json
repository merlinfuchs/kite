{
  "id": "flag-translator",
  "version": 2,
  "changelog": [
    {
      "version": 2,
      "notes": "Fixes flag reactions not translating anything, because a condition compared a yes or no with text."
    }
  ],
  "name": "Flag Translator",
  "description": "Translates a message when someone reacts to it with a country flag.",
  "about": [
    "When someone reacts to a message with a country flag, like 🇪🇸 or 🇯🇵, the bot replies with the message translated to the language of that flag. It works for 35 languages in every channel the bot can see, and keeps mentions, emoji and links as they are.",
    "Each flag translates a message once, even if people remove it and add it again, and a message that's already in the language gets no reply. Messages over 2,000 characters aren't translated, so the translation fits in the reply. The flags and their languages are in a Lookup Value block, so you can add flags or change their language."
  ],
  "faq": [
    {
      "question": "How many credits does a translation cost?",
      "answer": "4 credits for a message of up to 1,000 characters: 1 to remember the message was translated, 1 to look up the language of the flag, 1 to translate and 1 to reply. A message of up to 2,000 characters costs 5. Reactions that aren't flags cost nothing, and a flag without a language costs 2 credits once per message."
    },
    {
      "question": "Which flags work?",
      "answer": "The flags of the main countries of 35 languages, like 🇺🇸 and 🇬🇧 for English or 🇧🇷 for Brazilian Portuguese. Other flags are ignored. To add one, open the event listener and add a row to the Lookup Value block with the flag and the code of a language AI Translate supports, like 🇨🇱 and es."
    },
    {
      "question": "Does it translate a message more than once?",
      "answer": "Only for different flags. Each flag translates a message once, even if people remove it and add it again. 🇺🇸 and 🇬🇧 each get a reply though, even though both are English."
    },
    {
      "question": "What permissions does the bot need?",
      "answer": "View Channel, Read Message History, Send Messages and Embed Links in the channels people translate messages in."
    },
    {
      "question": "Do I need the Message Content Intent?",
      "answer": "Yes, or the bot can't read the messages to translate them. Turn it on under Bot in the Discord Developer Portal."
    },
    {
      "question": "Where are messages sent to be translated?",
      "answer": "To OpenAI. Only the text of the message is sent, not who wrote it."
    }
  ],
  "usage": {
    "unit": "translations",
    "unit_one": "translation",
    "per_thousand_members": 50
  },
  "icon": "languages",
  "category": "ai",
  "setup": [
    "Turn on the Message Content Intent under Bot in the Discord Developer Portal, so the bot can read the messages it translates."
  ],
