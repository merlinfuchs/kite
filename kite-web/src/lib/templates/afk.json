{
  "id": "afk",
  "version": 1,
  "name": "AFK",
  "description": "An /afk command that tells members who ping you that you're away, and welcomes you back when you talk again.",
  "about": [
    "Members use /afk with an optional reason, like /afk lunch, and the bot confirms it and adds [AFK] in front of their nickname. Without a reason, their status is just AFK.",
    "When someone pings a member who is AFK, the bot replies with their reason and how long ago they went AFK. As soon as the AFK member sends a message, the bot welcomes them back, removes their AFK and takes [AFK] off their nickname. AFK is per server, so being AFK in one server doesn't show in another."
  ],
  "faq": [
    {
      "question": "Does the bot ping anyone when it replies?",
      "answer": "No. Its replies mention the members by name, but pings are turned off, so the AFK member doesn't get pinged a second time."
    },
    {
      "question": "Why didn't my nickname change?",
      "answer": "The bot needs the Manage Nicknames permission, and its role has to be above yours. It can never change the nickname of the server owner. AFK still works without the nickname."
    },
    {
      "question": "What if a message pings several members?",
      "answer": "The bot checks the first member the message pings."
    }
  ],
  "usage": {
    "unit": "AFK replies",
    "unit_one": "reply",
    "per_thousand_members": 150
  },
  "icon": "moon",
  "category": "community",
  "setup": [
    "Turn on the Message Content intent for your bot, so it can see who a message pings."
  ],
  "parameters": [],
  "commands": [
    {
      "id": "afk",
      "flow_source": {
        "nodes": [
          {
            "id": "command_ctq",
            "type": "entry_command",
            "position": {
              "x": 0,
              "y": 210
            },
            "data": {
              "name": "afk",
              "description": "Set an AFK status to display when you are mentioned."
            }
          },
          {
            "id": "arg_eq6",
            "type": "option_command_argument",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "name": "reason",
              "description": "The AFK status to show when you're mentioned.",
              "command_argument_type": "string",
              "command_argument_required": false
            }
          },
          {
            "id": "variable_dr8",
            "type": "action_variable_set",
            "position": {
              "x": 0,
              "y": 420
            },
            "data": {
              "custom_label": "Save AFK",
              "variable_id": "afk-status",
              "variable_scope": "{{interaction.guild.id}}_{{interaction.user.id}}",
              "variable_operation": "overwrite",
              "variable_value": "{{now().Unix()}}|{{arg('reason') ?? \"AFK\"}}"
            }
          },
          {
            "id": "response_ws6",
            "type": "action_response_create",
            "position": {
              "x": 0,
              "y": 630
            },
            "data": {
              "message_data": {
                "content": "{{interaction.user.mention}} I set your AFK: {{arg('reason') ?? \"AFK\"}}",
                "allowed_mentions": {
                  "parse": []
                }
              }
            }
          },
          {
            "id": "error_e82",
            "type": "control_error_handler",
            "position": {
              "x": 0,
              "y": 840
            },
            "data": {
              "custom_label": "Skip if nickname can't change"
            }
          },
          {
            "id": "member_o3z",
            "type": "action_member_edit",
            "position": {
              "x": 205,
              "y": 1080
            },
            "data": {
              "custom_label": "Add [AFK] to nickname",
              "user_target": "{{interaction.user.id}}",
              "member_data": {
                "nick": "{{let n = \"[AFK] \" + (interaction.member.nick != \"\" ? interaction.member.nick : interaction.user.display_name); len(n) > 32 ? n[:32] : n}}"
              }
            }
          }
        ],
