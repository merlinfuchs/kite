{
  "id": "leveling",
  "version": 1,
  "name": "Leveling",
  "description": "Members earn XP for chatting and level up, with /rank, /leaderboard, and an optional reward role.",
  "about": [
    "Members earn 15 to 25 XP for a message, at most once a minute, so spamming doesn't help. Each level takes more XP than the one before. Level 1 needs 100 XP, level 2 needs 400, level 5 needs 2,500, and level 10 needs 10,000. When a member reaches a new level, the bot congratulates them in the level-up channel you pick, or in the channel they chatted in.",
    "/rank shows a member's level and how much XP they need for the next one. /leaderboard lists the members with the most XP, 10 per page. You can also pick a reward role that members get at a level you choose. XP is counted per server and kept in a stored variable, so it stays when the bot restarts."
  ],
  "faq": [
    {
      "question": "How many credits does it use?",
      "answer": "A message that earns XP uses 2 credits, one to add the XP and one to save the time. Messages within a minute of a member's last XP use none. A level-up message uses 1 more, /rank uses 1, and /leaderboard uses 2."
    },
    {
      "question": "Does the bot need the Message Content Intent?",
      "answer": "No. It counts messages without reading them."
    },
    {
      "question": "Can I change how much XP a message gives?",
      "answer": "Yes. Open the event listener and change the number in the Add 15 to 25 XP block. Levels follow from the XP, so level N always needs 100 × N² XP."
    },
    {
      "question": "Why didn't a member get the reward role?",
      "answer": "The bot needs the Manage Roles permission, and its own role has to be above the reward role. Members who were already past the reward level when you added the role get it the next time they level up."
    },
    {
      "question": "Is XP shared between servers?",
      "answer": "No. Each server has its own XP and its own leaderboard."
    }
  ],
  "usage": {
    "unit": "messages that earn XP",
    "unit_one": "message",
    "per_thousand_members": 1500
  },
  "icon": "trophy",
  "category": "community",
  "parameters": [
    {
      "key": "level_up_channel",
      "label": "Level-up channel",
      "description": "Where level-up messages go. Leave it empty to post them in the channel the member chatted in.",
      "type": "channel",
      "required": false
    },
    {
      "key": "reward_role",
      "label": "Reward role",
      "description": "A role members get when they reach the reward level. Leave it empty for no reward.",
      "type": "role",
      "required": false
    },
    {
      "key": "reward_level",
      "label": "Reward level",
      "description": "The level that gives the reward role, like 5.",
      "type": "text",
      "required": false,
      "default": "5"
    }
  ],
  "commands": [
    {
