          },
          {
            "id": "contexts_b2c",
            "type": "option_command_contexts",
            "position": {
              "x": 250,
              "y": 0
            },
            "data": {
              "command_disabled_contexts": ["bot_dm", "private_channel"]
            }
          },
          {
            "id": "command_b3l",
            "type": "entry_command",
            "position": {
              "x": 0,
              "y": 210
            },
            "data": {
              "name": "leaderboard",
              "description": "Show the members with the most XP."
            }
          },
          {
            "id": "values_b4t",
            "type": "action_variable_list",
            "position": {
              "x": 0,
              "y": 420
            },
            "data": {
              "custom_label": "10 members with the most XP",
              "variable_id": "xp",
              "variable_sort": "value_desc",
              "variable_scope_prefix": "{{interaction.guild.id}}:",
              "variable_limit": "10",
              "variable_skip": "{{(int(arg('page') ?? 1) - 1) * 10}}"
