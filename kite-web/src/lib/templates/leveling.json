          },
          {
            "id": "response_b5r",
            "type": "action_response_create",
            "position": {
              "x": 0,
              "y": 630
            },
            "data": {
              "message_data": {
                "embeds": [
                  {
                    "title": "Leaderboard",
                    "description": "{{let page = int(arg('page') ?? 1); let rows = result('values_b4t'); len(rows) == 0 ? (page == 1 ? \"No one has XP yet. Members earn it by chatting.\" : \"There's no one on page \" + string(page) + \".\") : join(map(rows, { \"**\" + string((page - 1) * 10 + #index + 1) + \".** <@\" + split(#.scope, \":\")[1] + \"> · Level \" + string(int((int(#.value) / 100) ** 0.5)) + \" · \" + string(int(#.value)) + \" XP\" }), \"\\n\")}}",
                    "footer": {
                      "text": "Page {{int(arg('page') ?? 1)}}"
                    },
                    "color": 5793266
                  }
                ],
                "allowed_mentions": {
                  "parse": []
                }
              }
            }
          }
        ],
