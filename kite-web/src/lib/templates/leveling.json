            "type": "option_command_argument",
            "position": {
              "x": -250,
              "y": 0
            },
            "data": {
              "name": "user",
              "description": "The member to show, yourself if empty.",
              "command_argument_type": "user",
              "command_argument_required": false
            }
          },
          {
            "id": "contexts_k2c",
            "type": "option_command_contexts",
            "position": {
              "x": 250,
              "y": 0
            },
            "data": {
              "command_disabled_contexts": ["bot_dm", "private_channel"]
            }
          },
          {
            "id": "command_k3r",
            "type": "entry_command",
            "position": {
              "x": 0,
              "y": 210
            },
            "data": {
              "name": "rank",
              "description": "Show your level and XP, or another member's."
            }
