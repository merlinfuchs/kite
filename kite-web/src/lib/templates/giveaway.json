{
  "id": "giveaway",
  "version": 2,
  "changelog": [
    {
      "version": 2,
      "notes": "The duration of /giveaway can also be written out, like 2 hours or 1 day and 12 hours."
    }
  ],
  "name": "Giveaways",
  "description": "A /giveaway command with an Enter button that picks random winners when it ends, plus a Reroll button.",
  "about": [
    "Members with the Manage Server permission start a giveaway with /giveaway, giving the prize, how long it runs, like 30m, 2 hours or 1d 12h, and optionally how many winners to pick and a role members need to enter. The bot posts the giveaway in the channel with an Enter button, and members see how many entered so far when they enter.",
    "When the time is up, the bot picks the winners at random, shows them in the giveaway message and pings them in a reply. Each member can enter once. If a winner doesn't claim the prize, members with the Manage Server permission can click Reroll to pick someone else, who the bot announces in the channel."
  ],
  "faq": [
    {
      "question": "How long can a giveaway run?",
      "answer": "Between 1 minute and 30 days. Write the duration like 30m, 2 hours or 1d 12h."
    },
    {
      "question": "How are the winners picked?",
      "answer": "At random from everyone who entered, and nobody can win twice in the same giveaway. Rerolling never picks someone who already won it, also not the winners of earlier rerolls."
    },
    {
      "question": "Who can start giveaways?",
      "answer": "Members with the Manage Server permission. You can change who sees /giveaway per role or channel under Integrations in your server settings."
    },
    {
      "question": "Can I limit a giveaway to a role?",
      "answer": "Yes. Pick the role in required_role when starting the giveaway, and only members with it can enter."
    },
    {
      "question": "How do I cancel a giveaway?",
      "answer": "Delete the giveaway message before it ends. The bot then doesn't pick any winners."
    },
    {
      "question": "How many credits does it use?",
      "answer": "Each entry costs 2 credits. Starting a giveaway and picking its winners costs 8 credits in total, and each reroll 3."
    }
  ],
