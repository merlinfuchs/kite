{
  "id": "giveaway",
  "version": 1,
  "name": "Giveaways",
  "description": "A /giveaway command with an Enter button that counts the entries and picks random winners when it ends, plus a reroll button.",
  "about": [
    "Members with the Manage Server permission start a giveaway with /giveaway, giving the prize, how long it runs, like 30m, 2h or 1d12h, and optionally how many winners to pick and a role members need to enter. The bot posts the giveaway in the channel with an Enter button, and the giveaway shows how many members entered so far.",
    "When the time is up, the bot picks the winners at random, shows them in the giveaway message and pings them in a reply. Each member can enter once. If a winner doesn't claim the prize, members with the Manage Server permission can click Reroll to pick someone else."
  ],
  "faq": [
    {
      "question": "How long can a giveaway run?",
      "answer": "Between 1 minute and 30 days. Combine units for the duration, like 1d12h or 2h30m."
    },
    {
      "question": "How are the winners picked?",
      "answer": "At random from everyone who entered, and nobody can win twice in the same giveaway. Rerolling never picks one of the original winners again."
    },
    {
      "question": "Who can start giveaways?",
      "answer": "Members with the Manage Server permission. You can change who sees /giveaway per role or channel under Integrations in your server settings."
    },
    {
      "question": "Can I limit a giveaway to a role?",
      "answer": "Yes. Pick the role in required_role when starting the giveaway, and only members with it can enter."
    }
  ],
  "usage": {
    "unit": "giveaway entries",
    "unit_one": "entry",
    "per_thousand_members": 200
  },
  "icon": "gift",
  "category": "community",
