{
  "id": "sticky-message",
  "version": 1,
  "name": "Sticky Message",
  "description": "Keeps a message at the bottom of a channel by posting it again when the channel goes quiet.",
  "about": [
    "Pick a channel and the template keeps a message at the bottom of it, like rules for a channel or how to ask for help. When someone sends a message there, the bot waits until no one has written for 3 seconds, then posts the sticky message again and deletes the previous one. A busy conversation only moves it once, after it calms down.",
    "You write the sticky message when you add the template, and can change it on the template page any time without opening the flow. It shows up after the next message in the channel."
  ],
  "faq": [
    {
      "question": "How do I change the sticky message?",
      "answer": "Change the Sticky Message parameter on the template page. The next time the bot posts it, it uses the new text."
    },
    {
      "question": "How many credits does it use?",
      "answer": "Each message in the sticky channel costs 1 credit, for remembering that it's the newest. Posting the sticky message again, remembering it and deleting the old one costs 3 more, but only once the channel is quiet, so 10 quick messages cost 13 credits. Messages in other channels don't run the flow at all."
    },
    {
      "question": "What permissions does the bot need?",
      "answer": "Send Messages and Manage Messages in the sticky channel, so it can post the message and delete the old one."
    }
  ],
  "usage": {
    "unit": "messages in the sticky channel",
    "unit_one": "message",
    "per_thousand_members": 300
  },
  "icon": "pin",
  "category": "community",
  "parameters": [
    {
      "key": "sticky_channel",
      "label": "Sticky Channel",
      "description": "The channel the message stays at the bottom of.",
      "type": "channel",
      "required": true
    },
    {
      "key": "sticky_text",
      "label": "Sticky Message",
      "description": "What the message says. Markdown works, like bold text and links, and it doesn't ping anyone.",
      "type": "textarea",
      "required": true
    }
  ],
  "commands": [],
  "event_listeners": [
    {
      "id": "sticky-repost",
      "source": "discord",
      "flow_source": {
        "nodes": [
          {
            "id": "filter_c4n",
            "type": "option_event_filter",
            "position": {
              "x": 205,
              "y": 0
            },
            "data": {
              "event_filter_target": "channel_id",
              "event_filter_mode": "equal",
              "event_filter_value": "{{params.sticky_channel}}"
            }
          },
          {
            "id": "event_cwk",
            "type": "entry_event",
            "position": {
              "x": 205,
              "y": 210
            },
            "data": {
              "event_type": "message_create",
              "description": "Keep the sticky message at the bottom of its channel."
            }
          },
          {
            "id": "variable_l7q",
            "type": "action_variable_set",
            "position": {
              "x": 205,
              "y": 420
            },
            "data": {
              "custom_label": "Remember the newest message",
              "variable_id": "sticky-last-message-id",
              "variable_scope": "{{params.sticky_channel}}",
              "variable_operation": "overwrite",
              "variable_value": "{{event.message.id}}"
            }
          },
          {
            "id": "sleep_w2d",
            "type": "control_sleep",
            "position": {
              "x": 205,
              "y": 630
            },
            "data": {
              "custom_label": "Wait for the channel to go quiet",
              "sleep_duration_seconds": "3"
            }
          },
          {
            "id": "variable_k3m",
            "type": "action_variable_get",
            "position": {
              "x": 205,
              "y": 840
            },
            "data": {
              "custom_label": "Newest message",
              "variable_id": "sticky-last-message-id",
              "variable_scope": "{{params.sticky_channel}}"
            }
          },
          {
            "id": "condition_udg",
            "type": "control_condition_compare",
            "position": {
              "x": 205,
              "y": 1050
            },
            "data": {
              "custom_label": "Still the newest?",
              "condition_base_value": "{{result('variable_k3m')}}"
            }
          },
          {
            "id": "condition_xv1",
            "type": "control_condition_item_compare",
            "position": {
              "x": 205,
              "y": 1260
            },
            "data": {
              "condition_item_mode": "equal",
              "condition_item_value": "{{event.message.id}}"
            }
          },
          {
            "id": "condition_yv3",
            "type": "control_condition_item_else",
            "position": {
              "x": 615,
              "y": 1260
            },
            "data": {}
          },
          {
            "id": "variable_ifb",
            "type": "action_variable_get",
            "position": {
              "x": 205,
              "y": 1470
            },
            "data": {
              "custom_label": "Last sticky message",
              "variable_id": "sticky-message-id",
              "variable_scope": "{{params.sticky_channel}}"
            }
          },
          {
            "id": "message_qag",
            "type": "action_message_create",
            "position": {
              "x": 205,
              "y": 1680
            },
            "data": {
              "custom_label": "Post sticky message",
              "channel_target": "{{params.sticky_channel}}",
              "message_data": {
                "content": "{{params.sticky_text}}",
                "allowed_mentions": {
                  "parse": []
                }
              }
            }
          },
          {
            "id": "variable_xsb",
            "type": "action_variable_set",
            "position": {
              "x": 205,
              "y": 1890
            },
            "data": {
              "custom_label": "Remember it",
              "variable_id": "sticky-message-id",
              "variable_scope": "{{params.sticky_channel}}",
              "variable_operation": "overwrite",
              "variable_value": "{{result('message_qag').id}}"
            }
          },
          {
            "id": "error_bhe",
            "type": "control_error_handler",
            "position": {
              "x": 205,
              "y": 2100
            },
            "data": {
              "custom_label": "Skip if it's already gone"
            }
          },
          {
            "id": "message_682",
            "type": "action_message_delete",
            "position": {
              "x": 410,
              "y": 2340
            },
            "data": {
              "custom_label": "Delete the old one",
              "channel_target": "{{params.sticky_channel}}",
              "message_target": "{{result('variable_ifb')}}"
            }
          }
        ],
        "edges": [
