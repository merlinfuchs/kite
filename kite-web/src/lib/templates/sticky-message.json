{
  "id": "sticky-message",
  "version": 1,
  "name": "Sticky Message",
  "description": "Keeps a message at the bottom of a channel by posting it again when the channel goes quiet.",
  "about": [
    "Pick a channel and the template keeps a message at the bottom of it, like rules for a channel or how to ask for help. When someone sends a message there, the bot waits until no one has written for 3 seconds, then posts the sticky message again and deletes the previous one. A busy conversation only moves it once, after it calms down.",
    "You write the sticky message in the message editor when you add the template, with text, embeds or images, and can change it under Messages any time without opening the flow. It shows up after the next message in the channel."
  ],
  "faq": [
    {
      "question": "How do I change the sticky message?",
      "answer": "Edit the Sticky message under Messages in your app. The next time the bot posts it, it uses the new version."
    },
    {
      "question": "How many credits does it use?",
      "answer": "Messages in the sticky channel are free. Each time the bot posts the sticky message again, it costs 3 credits for posting it, remembering it and deleting the old one. A busy conversation only costs that once, after it calms down, and messages in other channels don't run the flow at all."
    },
    {
      "question": "Does it move below messages from other bots?",
      "answer": "No, only messages from members make the bot post it again. Messages from bots, like feeds, stay below the sticky message until a member writes."
    },
    {
      "question": "What permissions does the bot need?",
      "answer": "Send Messages, Read Message History and Manage Messages in the sticky channel, so it can post the message, check that no one wrote after it and delete the old one."
    }
  ],
  "usage": {
    "unit": "sticky reposts",
    "unit_one": "repost",
    "per_thousand_members": 100
  },
  "icon": "pin",
  "category": "community",
  "parameters": [
    {
      "key": "sticky_channel",
      "label": "Sticky Channel",
      "description": "The channel the message stays at the bottom of.",
      "type": "channel",
      "required": true
    }
  ],
  "commands": [],
  "event_listeners": [
    {
      "id": "sticky-repost",
      "source": "discord",
      "flow_source": {
        "nodes": [
          {
            "id": "filter_c4n",
            "type": "option_event_filter",
            "position": {
              "x": 205,
              "y": 0
            },
            "data": {
              "event_filter_target": "channel_id",
              "event_filter_mode": "equal",
