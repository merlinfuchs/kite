{
  "id": "economy",
  "version": 1,
  "name": "Economy",
  "description": "Members earn coins with /daily and /work, send them with /pay, and compete on /richest.",
  "about": [
    "Members collect 100 coins a day with /daily and earn 20 to 60 coins an hour with /work. /balance shows how many coins a member has, /pay sends coins to another member, and /richest lists the members with the most, 10 per page.",
    "You can rename the coins and change the daily amount when you add the template. Members with the Manage Server permission can give or take coins with /add-coins. Balances are counted per server and kept in a stored variable, so they stay when the bot restarts."
  ],
  "faq": [
    {
      "question": "How many credits does it use?",
      "answer": "/balance uses 1 credit, /richest and /add-coins 2, and /daily, /work, and /pay 3 each. Reading balances is free, and saving them costs 1 credit each."
    },
    {
      "question": "Can members spend their coins?",
      "answer": "Only on each other with /pay. The template has no shop. You can build one with a command that checks the balance with a Comparison Condition, takes the coins with a Set stored variable block, and gives a role."
    },
    {
      "question": "Can a balance go below zero?",
      "answer": "Only with /add-coins. /pay checks the balance before it sends anything, and gives the coins back if two payments at once would take it below zero."
    },
    {
      "question": "How do I reset everyone's coins?",
      "answer": "Open Stored variables in the sidebar and delete the values of the balance variable."
    },
    {
      "question": "Are balances shared between servers?",
      "answer": "No. Each server has its own balances and its own /richest list."
    }
  ],
  "usage": {
    "unit": "commands used",
    "unit_one": "command",
    "per_thousand_members": 600
  },
  "icon": "coins",
  "category": "games",
  "parameters": [
    {
      "key": "currency",
      "label": "Currency",
      "description": "What the coins are called in messages, like coins or gems.",
      "type": "text",
      "required": true,
      "default": "coins"
    },
    {
      "key": "daily_amount",
      "label": "Daily amount",
      "description": "How many coins /daily gives.",
      "type": "text",
      "required": true,
      "default": "100"
    }
  ],
