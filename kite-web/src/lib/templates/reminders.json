{
  "id": "reminders",
  "version": 1,
  "name": "Reminders",
  "description": "A /remind command that sends members a reminder in their DMs after the time they pick.",
  "about": [
    "Members use /remind with when to remind them, like 30m, 2 hours or 1d 12h, and what to remind them of. The bot confirms the reminder in a reply only they can see, with the exact time it goes off.",
    "When the time is up, the bot sends the reminder in their DMs. If their DMs are closed, it pings them with the reminder in the channel they used /remind in instead. Reminders can be up to 30 days away."
  ],
  "faq": [
    {
      "question": "How far ahead can I set a reminder?",
      "answer": "Between 1 minute and 30 days. Write the time like 30m, 2 hours or 1d 12h."
    },
    {
      "question": "What if my DMs are closed?",
      "answer": "The bot pings you with the reminder in the channel you used /remind in."
    },
    {
      "question": "Can other members see my reminders?",
      "answer": "No. The confirmation only shows to you and the reminder goes to your DMs, unless your DMs are closed."
    },
    {
      "question": "How many reminders can I set?",
      "answer": "Up to 10 can be waiting at a time, and you can set one every 30 seconds. Once a reminder goes off, you can set a new one."
    },
    {
      "question": "How many credits does it use?",
      "answer": "4 credits for each reminder: reading the time, remembering it, confirming it and sending the reminder. Waiting costs nothing."
    }
  ],
  "usage": {
    "unit": "reminders",
    "unit_one": "reminder",
    "per_thousand_members": 100
  },
  "icon": "alarm-clock",
  "category": "community",
