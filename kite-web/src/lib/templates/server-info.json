            "data": {
              "message_data": {
                "embeds": [
                  {
                    "author": {
                      "name": "{{(arg('user') ?? user).username}}"
                    },
                    "thumbnail": {
                      "url": "{{(arg('user') ?? user).avatar_url}}"
                    },
                    "description": "{{(arg('user') ?? user).mention}}",
                    "fields": [
                      {
                        "name": "ID",
                        "value": "{{(arg('user') ?? user).id}}",
                        "inline": true
                      },
                      {
                        "name": "Bot",
                        "value": "{{(arg('user') ?? user).is_bot ? 'Yes' : 'No'}}",
                        "inline": true
                      },
                      {
                        "name": "Account Created",
                        "value": "<t:{{(arg('user') ?? user).created_at}}:R>",
                        "inline": true
                      },
                      {
                        "name": "Joined Server",
                        "value": "{{(arg('user') ?? user).joined_at > 0 ? '<t:' + string((arg('user') ?? user).joined_at) + ':R>' : 'Not in this server'}}",
                        "inline": true
                      },
                      {
                        "name": "Top Role",
                        "value": "{{(arg('user') ?? user).role_count > 0 ? (arg('user') ?? user).top_role.mention : 'None'}}",
                        "inline": true
                      },
                      {
                        "name": "Roles",
