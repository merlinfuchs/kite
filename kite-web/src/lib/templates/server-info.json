{
  "id": "server-info",
  "version": 1,
  "name": "Server Info",
  "description": "The commands /avatar, /userinfo and /serverinfo.",
  "about": [
    "/avatar shows a user's avatar in full size. /userinfo shows their ID, when they created their account and joined the server, their highest role and how many roles they have. Both show the member who uses them, unless they pick another user.",
    "/serverinfo shows the server's owner, member count, creation date, number of channels and roles, and boosts. /userinfo and /serverinfo only work in servers, so Discord hides them in DMs."
  ],
  "faq": [
    {
      "question": "Does the bot need any permissions?",
      "answer": "No. The commands reply to the interaction, so the bot doesn't need to send messages in the channel, and it needs no privileged intents."
    },
    {
      "question": "Can I show more info about a user?",
      "answer": "Yes. Open /userinfo in the editor and add fields to the embed. The placeholder picker lists everything Kite knows about a member, like their nickname, role color or whether they're boosting."
    },
    {
      "question": "Why does /userinfo say \"Not in this server\"?",
      "answer": "The picked user isn't a member of the server, so there's no join date or roles to show."
    }
  ],
  "usage": {
    "unit": "info commands",
    "unit_one": "command",
    "per_thousand_members": 50
  },
  "icon": "info",
  "category": "community",
  "parameters": [],
  "commands": [
    {
      "id": "avatar",
      "flow_source": {
