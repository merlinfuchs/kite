{
  "openapi": "3.1.0",
  "info": {
    "title": "Cookie API",
    "version": "1",
    "description": "Written by hand from https://docs.cookie-api.com, which has no spec. Only the endpoints Kite uses."
  },
  "servers": [{ "url": "https://api.cookie-api.com" }],
  "components": {
    "securitySchemes": {
      "ApiKey": { "type": "apiKey", "in": "header", "name": "Authorization" }
    }
  },
  "security": [{ "ApiKey": [] }],
  "paths": {
    "/api/time/current-time": {
      "get": {
        "operationId": "get_current_time",
        "summary": "The current time, which Kite requests to check an API key",
        "responses": { "200": { "description": "The key is valid" } }
      }
    },
    "/api/images/qr-code": {
      "post": {
        "operationId": "create_qr_code",
        "summary": "Generate a QR code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["data"],
                "properties": {
                  "data": { "type": "string" },
                  "style": { "type": "string", "enum": ["dots", "standart"] },
                  "border": { "type": "integer" },
                  "center_image_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The QR code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "url": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
