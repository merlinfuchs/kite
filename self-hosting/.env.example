# Make a Discord application in the Discord Developer Portal. For local
# testing, add http://localhost:8080/v1/auth/login/callback as its redirect URL.
KITE_DISCORD__CLIENT_ID=
KITE_DISCORD__CLIENT_SECRET=

# Generate with: openssl rand -hex 32
KITE_ENCRYPTION__TOKEN_ENCRYPTION_KEY=

# Add your Discord user ID and the IDs of any friends who should be able to log
# in. Separate IDs with commas. Right-click a user in Discord with Developer
# Mode enabled, then choose Copy User ID.
KITE_SELF_HOSTED__ENABLED=true
KITE_SELF_HOSTED__ALLOWED_DISCORD_IDS=

# Optional. Without these, uploaded assets and voice/audio assets won't work.
# Configure an S3-compatible bucket before setting these values.
# KITE_DATABASE__S3__ENDPOINT=
# KITE_DATABASE__S3__ACCESS_KEY_ID=
# KITE_DATABASE__S3__SECRET_ACCESS_KEY=
# KITE_DATABASE__S3__SECURE=true

# Optional AI providers. Their usage is billed by the provider.
# KITE_OPENAI__API_KEY=
# KITE_OPENROUTER__API_KEY=
