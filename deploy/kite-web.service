# Generated by deploy/generate.sh from deploy/config.env, don't edit.
#
# The Next.js server of kite.onl, deployed to /opt/kite-web by
# deploy/web.sh. nginx serves /_next/static and public/ itself.
[Unit]
Description=Kite web
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/opt/kite-web
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3000
ExecStart=/usr/bin/node server.js
# Node exits with 128 + SIGTERM when stopped.
SuccessExitStatus=143
Restart=always
RestartSec=5
DynamicUser=yes

[Install]
WantedBy=multi-user.target
