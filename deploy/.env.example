# SSH destination, e.g. root@203.0.113.10
DEPLOY_HOST=

# Directories on the server
WEB_DIR=/var/www/kite-web
DOCS_DIR=/var/www/kite-docs
SERVICE_DIR=/opt/kite

# systemd units of the service clusters. They share the binary in SERVICE_DIR
# and are restarted one after another, waiting SERVICE_RESTART_DELAY seconds
# and checking each is still running before moving on.
SERVICE_UNITS="kite-service@0 kite-service@1 kite-service@2 kite-service@3"
SERVICE_RESTART_DELAY=10

# CPU architecture of the server
SERVICE_ARCH=amd64

# Baked into the web build
NEXT_PUBLIC_API_PUBLIC_BASE_URL=https://api.kite.onl
NEXT_PUBLIC_DOCS_LINK=https://docs.kite.onl
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/rNd9jWHnXh

# Baked into the docs build
APP_BASE_URL=https://kite.onl
