# SSH destination, e.g. root@203.0.113.10
DEPLOY_HOST=

# Directories on the server
WEB_DIR=/var/www/kite-web
DOCS_DIR=/var/www/kite-docs
SERVICE_DIR=/opt/kite

# systemd unit and CPU architecture of the server
SERVICE_NAME=kite-service
SERVICE_ARCH=amd64

# Baked into the web build
NEXT_PUBLIC_API_PUBLIC_BASE_URL=https://api.kite.onl
NEXT_PUBLIC_DOCS_LINK=https://docs.kite.onl
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/rNd9jWHnXh

# Baked into the docs build
APP_BASE_URL=https://kite.onl
