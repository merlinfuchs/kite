# Generated by deploy/generate.sh from deploy/config.env, don't edit.
#
# Service cluster %i of 4, run as kite-service@0 to kite-service@N.
# Reads kite.toml from /opt/kite and applies migrations on every start.
[Unit]
Description=Kite cluster %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/kite
Environment=KITE_CLUSTER_COUNT=4
Environment=KITE_CLUSTER_INDEX=%i
ExecStartPre=/opt/kite/kite-service database migrate postgres up
ExecStart=/bin/sh -c 'KITE_API__PORT=$$((8080 + %i)) exec /opt/kite/kite-service server start'
Restart=always

[Install]
WantedBy=multi-user.target
