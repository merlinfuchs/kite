kite.onl {
	root * /var/www/kite-web
	encode zstd gzip
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

	# Written by kite-web/scripts/export-node-info.ts, read by the docs.
	handle /api/flow/nodes/* {
		header Access-Control-Allow-Origin https://docs.kite.onl
		rewrite * {path}.json
		file_server
	}

	# The export writes dynamic routes to literal files like apps/[appId].html.
	@app path_regexp ^/apps/[^/]+/?$
	handle @app {
		rewrite * "/apps/[appId].html"
		file_server
	}

	@appPage path_regexp page ^/apps/[^/]+/([^/]+)/?$
	handle @appPage {
		rewrite * "/apps/[appId]/{re.page.1}.html"
		file_server
	}

	@appItem path_regexp item ^/apps/[^/]+/(commands|events|messages|variables)/[^/]+/?$
	handle @appItem {
		map {re.item.1} {itemParam} {
			commands cmdId
			events eventId
			messages messageId
			variables variableId
		}
		rewrite * "/apps/[appId]/{re.item.1}/[{itemParam}].html"
		file_server
	}

	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

docs.kite.onl {
	root * /var/www/kite-docs
	encode zstd gzip
	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

api.kite.onl {
	reverse_proxy localhost:8080
}
