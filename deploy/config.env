# Production setup. After changing it, run deploy/generate.sh and commit the
# result, then deploy/server.sh to apply it.

# Number of service clusters, each running a share of the apps. Must divide
# 10000, so nginx's split_clients can match util.CluserForKey exactly
# (1, 2, 4, 5, 8, 10, 16, 20, 25, ...).
CLUSTER_COUNT=4
# Cluster N listens on SERVICE_BASE_PORT + N.
SERVICE_BASE_PORT=8080

WEB_DOMAIN=kite.onl
DOCS_DOMAIN=docs.kite.onl
API_DOMAIN=api.kite.onl

# Paths on the server
WEB_DIR=/var/www/kite-web
DOCS_DIR=/var/www/kite-docs
SERVICE_DIR=/opt/kite
SUPPORT_DIR=/opt/kite-support
NIRN_PROXY_DIR=/opt/nirn-proxy
NGINX_CONF_PATH=/etc/nginx/sites-enabled/kite

# CPU architecture of the server
SERVICE_ARCH=amd64

# Largest request body the API accepts. Assets can be up to 8 MB
# (max_asset_size) plus multipart overhead.
API_MAX_BODY_SIZE=10M

# OpenPanel API that WEB_DOMAIN/ops forwards analytics events to
OPENPANEL_URL=https://analytics.xenon.bot/api

# Baked into the web build
NEXT_PUBLIC_API_PUBLIC_BASE_URL=https://api.kite.onl
NEXT_PUBLIC_DOCS_LINK=https://docs.kite.onl
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/rNd9jWHnXh
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=b14a6614-59bb-481e-8de0-ae685dd67de1

# Baked into the docs build
APP_BASE_URL=https://kite.onl
